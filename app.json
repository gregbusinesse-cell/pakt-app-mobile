{
  "expo": {
    "name": "PAKT",
    "slug": "pakt",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "pakt",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pakt.app",
      "buildNumber": "51",
      "infoPlist": {
        "NSCameraUsageDescription": "PAKT a besoin de la camera pour prendre des photos de profil.",
        "NSPhotoLibraryUsageDescription": "PAKT a besoin d'acceder a tes photos pour ton profil.",
        "NSLocationWhenInUseUsageDescription": "PAKT utilise ta position pour trouver des personnes pres de toi.",
        "NSMicrophoneUsageDescription": "PAKT a besoin du micro pour envoyer des messages vocaux.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "package": "com.pakt.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "versionCode": 5
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/Ionicons.ttf",
            "./node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/MaterialIcons.ttf"
          ]
        }
      ],
      "expo-image-picker",
      "expo-location",
      "expo-asset",
      "expo-av",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
