default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    setup_ci if is_ci

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house: false
    )

    # Ensure the App ID has Sign In with Apple enabled, otherwise match's
    # generated provisioning profile won't include the required entitlement.
    begin
      produce(
        app_identifier: "com.pakt.app",
        team_id: ENV["TEAM_ID"],
        skip_itc: true,
        enable_services: {
          apple_sign_in: "on"
        }
      )
    rescue => e
      UI.important("produce enable_services failed (#{e.message}) - continuing, this may need to be enabled manually at developer.apple.com")
    end

    # Fetch (or generate, on first run) certificates and provisioning profiles with match.
    # Using the App Store Connect API key means no Apple ID password / 2FA prompt is ever needed.
    match(
      type: "appstore",
      app_identifier: "com.pakt.app",
      git_url: "https://github.com/gregbusinesse-cell/pakt-certificates.git",
      git_basic_authorization: Base64.strict_encode64("#{ENV['GIT_AUTHORIZATION']}:x-oauth-basic"),
      api_key: api_key,
      readonly: false,
      force: true,
      verbose: true
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "PAKT.xcodeproj",
      team_id: ENV["TEAM_ID"],
      code_sign_identity: "Apple Distribution",
      profile_name: "match AppStore com.pakt.app",
      targets: ["PAKT"]
    )

    build_app(
      workspace: "pakt.xcworkspace",
      scheme: "PAKT",
      configuration: "Release",
      export_method: "app-store",
      export_team_id: ENV["TEAM_ID"],
      export_options: {
        provisioningProfiles: {
          "com.pakt.app" => "match AppStore com.pakt.app"
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: "com.pakt.app",
      skip_waiting_for_build_processing: true,
      skip_submission: false
    )

    puts "✅ Build uploaded to TestFlight!"
  end
end
